<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0F172A">
  <title><%= typeof title !== 'undefined' && title ? title + ' - ESFCEx Informática' : 'ESFCEx Informática' %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@600;700&family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/professional.css">
</head>
<body>
<div class="mobile-topbar">
  <div class="mobile-brand"><span class="brand-mark">EP</span><span><strong>ESFCEx</strong><small>Dossiê de preparação</small></span></div>
  <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-menu-toggle><span></span><span></span><span></span></button>
</div>
<div class="menu-backdrop" data-menu-backdrop></div>
<div class="app">
  <aside class="sidebar" data-sidebar>
    <div class="sidebar-top">
      <div class="brand"><span class="brand-mark">EP</span><span>DOSSIÊ DE PREPARAÇÃO<span class="title">ESFCEx · Informática</span></span></div>
