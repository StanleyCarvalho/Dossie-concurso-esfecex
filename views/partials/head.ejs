    </div>
    <nav class="nav">
      <span class="nav-section">Visão estratégica</span>
      <a href="/" class="<%= active === 'dashboard' ? 'active' : '' %>"><span class="num">01</span>Painel geral</a>
      <a href="/proxima-prova" class="<%= active === 'proxima' ? 'active' : '' %>"><span class="num">02</span>Possível próxima prova</a>
      <a href="/previsao-ia" class="<%= active === 'previsao' ? 'active' : '' %>"><span class="num">03</span>Previsão IA calibrada</a>
      <a href="/analise" class="<%= active === 'analise' ? 'active' : '' %>"><span class="num">04</span>Análise de padrões</a>
      <span class="nav-section">Plano e execução</span>
      <a href="/plano-estudos" class="<%= active === 'plano' ? 'active' : '' %>"><span class="num">05</span>Plano diário e semanal</a>
      <a href="/estudar-hoje" class="<%= active === 'hoje' ? 'active' : '' %>"><span class="num">06</span>O que estudar hoje</a>
      <a href="/treino" class="<%= active === 'treino' ? 'active' : '' %>"><span class="num">07</span>Treino por assunto</a>
      <a href="/caderno-erros" class="<%= active === 'erros' ? 'active' : '' %>"><span class="num">08</span>Caderno de erros</a>
      <a href="/simulados" class="<%= active === 'simulados' ? 'active' : '' %>"><span class="num">09</span>Simulados</a>
      <span class="nav-section">Banco e evidências</span>
      <a href="/editais" class="<%= active === 'editais' ? 'active' : '' %>"><span class="num">10</span>Editais</a>
      <a href="/questoes-repetidas" class="<%= active === 'repetidas' ? 'active' : '' %>"><span class="num">11</span>Repetidas por assunto</a>
      <a href="/recorrencias" class="<%= active === 'recorrencias' ? 'active' : '' %>"><span class="num">12</span>Questões recorrentes</a>
      <a href="/dificuldade" class="<%= active === 'dificuldade' ? 'active' : '' %>"><span class="num">13</span>Dificuldade das questões</a>
      <a href="/questoes" class="<%= active === 'questoes' ? 'active' : '' %>"><span class="num">14</span>Banco de questões</a>
      <a href="/import" class="<%= active === 'import' ? 'active' : '' %>"><span class="num">15</span>Importar provas</a>
    </nav>
    <% if (user) { %><div class="user-box"><strong><%= user.name || user.email %></strong><span><%= user.email %></span><form method="POST" action="/logout"><button class="btn secondary" type="submit">Sair</button></form></div><% } %>
