<%- include('partials/head', { title: 'Treino por assunto' }) %>
<div class="page-header"><span class="eyebrow">Fixação ativa</span><h1>Treino por assunto</h1><p class="muted">Resolva questões reais do mesmo assunto; quando necessário, gere questões inéditas calibradas pelo histórico da banca.</p></div>
<section class="card"><form method="GET" action="/treino" class="filters"><label>Disciplina<input name="discipline" value="<%= discipline %>" required></label><label>Assunto<input name="topic" value="<%= topic %>" required></label><button class="btn" type="submit">Buscar questões</button></form></section>
<% if(discipline&&topic){ %><section class="card"><div class="section-header"><h2><%= discipline %> · <%= topic %></h2><form method="POST" action="/treino/gerar"><input type="hidden" name="discipline" value="<%= discipline %>"><input type="hidden" name="topic" value="<%= topic %>"><button class="btn secondary" type="submit">Gerar 5 inéditas no padrão</button></form></div><% if(!questions.length){ %><p class="muted">Não há questão real classificada exatamente neste assunto. Você pode gerar treino inédito.</p><% } %><% questions.forEach((q,index)=>{ %><article class="question-card" data-question="<%= q.id %>"><div class="meta"><strong>Questão <%= index+1 %></strong><span><%= q.ano ? 'Prova '+q.ano : 'Treino IA' %></span></div><p><%= q.statement %></p><% ['a','b','c','d','e'].forEach(letter=>{ if(q['alt_'+letter]){ %><label class="alternative"><input type="radio" name="q_<%= q.id %>" value="<%= letter.toUpperCase() %>"> <strong><%= letter.toUpperCase() %>)</strong> <%= q['alt_'+letter] %></label><% } }) %><button class="btn answer-btn" type="button" onclick="answerQuestion(<%= q.id %>, this)">Responder</button><div class="answer-result"></div></article><% }) %></section><% } %>
<script>async function answerQuestion(id,btn){const card=btn.closest('[data-question]');const picked=card.querySelector('input[type=radio]:checked');if(!picked){card.querySelector('.answer-result').textContent='Selecione uma alternativa.';return;}const r=await fetch('/treino/'+id+'/responder',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({letter:picked.value})});const data=await r.json();card.querySelector('.answer-result').innerHTML=data.correct?'✅ Correto':'❌ Incorreto. Gabarito: <strong>'+data.correctLetter+'</strong>';btn.disabled=true;}</script>
<%- include('partials/foot') %>