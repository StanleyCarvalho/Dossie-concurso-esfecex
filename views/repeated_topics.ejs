<%- include('partials/head', { title: 'Questões repetidas por assunto' }) %>
<div class="page-header"><span class="eyebrow">Recorrência real</span><h1>Questões repetidas por assunto</h1><p class="muted">Ranking dos assuntos que mais voltaram nas provas oficiais. A recorrência é calculada pelo banco real, sem a IA inventar frequência.</p></div>
<% if(!topics.length){ %><div class="empty">Ainda não há assuntos com recorrência em pelo menos dois anos.</div><% } %>
<% topics.forEach((x,i)=>{ %><article class="card" style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;gap:16px"><div><span class="tag gold">#<%= i+1 %></span><span class="tag"><%= x.discipline %></span><h3><%= x.topic %></h3><p class="muted"><strong><%= x.occurrences %></strong> questões em <strong><%= x.years_count %></strong> anos: <%= x.years.join(', ') %></p></div><div><a class="btn secondary" href="/treino?discipline=<%= encodeURIComponent(x.discipline) %>&topic=<%= encodeURIComponent(x.topic) %>">Treinar assunto</a></div></div><div style="margin-top:10px"><% (x.question_ids||[]).slice(0,8).forEach(id=>{ %><a class="tag" href="/questoes?question=<%= id %>">Questão #<%= id %></a><% }) %></div></article><% }) %>
<%- include('partials/foot') %>