<%- include('partials/head', { title: 'Questões recorrentes' }) %>
<div class="page-header"><span class="eyebrow">Padrão histórico real</span><h1>Questões e assuntos recorrentes</h1><p class="muted">Recorrência por assunto e similaridade entre enunciados de anos diferentes.</p></div>
<form method="POST" action="/recorrencias/recalcular"><button class="btn" type="submit">Recalcular similaridades</button></form>
<section class="card"><h2>Assuntos mais recorrentes</h2><div class="table-wrap"><table><thead><tr><th>Disciplina</th><th>Assunto</th><th>Ocorrências</th><th>Anos</th></tr></thead><tbody><% recurrences.forEach(r=>{ %><tr><td><%= r.discipline %></td><td><%= r.topic %></td><td><strong><%= r.occurrences %></strong></td><td><%= (r.years||[]).join(', ') %></td></tr><% }) %></tbody></table></div></section>
<section class="card"><h2>Questões repetidas ou reformuladas</h2><% if(!repeated.length){ %><p class="muted">Clique em recalcular similaridades para montar o mapa.</p><% } %><% repeated.forEach(x=>{ %><article class="question-card"><div class="meta"><strong><%= x.discipline %> · <%= x.topic %></strong><span><%= Math.round(Number(x.similarity)*100) %>% · <%= x.relation_type %></span></div><p><strong><%= x.a_year %>:</strong> <%= x.a_statement %></p><p><strong><%= x.b_year %>:</strong> <%= x.b_statement %></p><div class="actions"><a class="btn secondary" href="/questoes?question=<%= x.a_id %>">Abrir <%= x.a_year %></a><a class="btn secondary" href="/questoes?question=<%= x.b_id %>">Abrir <%= x.b_year %></a></div></article><% }) %></section>
<%- include('partials/foot') %>