<%- include('partials/head', { title: 'Caderno de erros' }) %>
<div class="page-header"><span class="eyebrow">Revisão orientada por falhas</span><h1>Caderno de erros</h1><p class="muted">Cada erro em treino fica registrado para orientar revisões e recalcular seu domínio por assunto.</p></div>
<section class="card"><% if(!errors.length){ %><p class="muted">Nenhum erro registrado ainda. Resolva questões no treino por assunto.</p><% } %><% errors.forEach(e=>{ %><article class="question-card"><div class="meta"><strong><%= e.discipline %> · <%= e.topic %></strong><span><%= e.ano ? 'Prova '+e.ano : 'Treino' %> · <%= new Date(e.answered_at).toLocaleDateString('pt-BR') %></span></div><p><%= e.statement %></p><p><strong>Sua resposta:</strong> <%= e.chosen_letter || '—' %> · <strong>Gabarito:</strong> <%= e.correct_letter || '—' %></p><a class="btn secondary" href="/treino?discipline=<%= encodeURIComponent(e.discipline) %>&topic=<%= encodeURIComponent(e.topic) %>">Treinar novamente</a></article><% }) %></section>
<%- include('partials/foot') %>