<%- include('partials/head', { title: 'Administração de acessos' }) %>
<div class="page-header"><span class="eyebrow">Administração</span><h1>Usuários e períodos de acesso</h1><p class="muted">Aprove novos cadastros, defina até quando cada aluno poderá acessar a plataforma, renove períodos e bloqueie acessos quando necessário.</p></div>
<% if(message){ %><div class="notice success"><%= message %></div><% } %>
<section class="card"><div class="section-header"><div><h2>Cadastros</h2><p class="muted">Cadastros pendentes aparecem primeiro.</p></div></div><div class="admin-user-list"><% users.forEach(u=>{ %><article class="admin-user-card"><div class="admin-user-head"><div><strong><%= u.name || 'Sem nome' %></strong><div class="muted"><%= u.email %></div></div><div><span class="tag <%= u.access_state === 'active' || u.access_state === 'admin' ? 'gold' : '' %>"><%= u.access_state === 'admin' ? 'Administrador' : u.access_state === 'pending' ? 'Pendente' : u.access_state === 'active' ? 'Ativo' : u.access_state === 'expired' ? 'Expirado' : 'Bloqueado' %></span></div></div><div class="admin-user-meta"><span><strong>Cadastro:</strong> <%= new Date(u.created_at).toLocaleDateString('pt-BR') %></span><span><strong>Validade:</strong> <%= u.role === 'admin' ? 'Sem expiração' : (u.access_until ? new Date(u.access_until).toLocaleDateString('pt-BR') : 'Não definida') %></span><span><strong>Cidade:</strong> <%= u.city || '—' %></span><span><strong>Ocupação:</strong> <%= u.occupation || '—' %></span></div><% if(u.role !== 'admin'){ %><div class="admin-user-actions"><form method="POST" action="/admin/usuarios/<%= u.id %>/aprovar"><label>Aprovar / liberar até<input type="date" name="access_until" value="<%= u.access_until ? String(u.access_until).slice(0,10) : '' %>" required></label><button class="btn" type="submit"><%= u.approval_status === 'approved' ? 'Renovar acesso' : 'Aprovar cadastro' %></button></form><form method="POST" action="/admin/usuarios/<%= u.id %>/bloquear"><button class="btn secondary danger-btn" type="submit" onclick="return confirm('Bloquear o acesso deste aluno?')">Bloquear</button></form><form method="POST" action="/admin/usuarios/<%= u.id %>/pendente"><button class="btn secondary" type="submit">Voltar para pendente</button></form></div><% } %></article><% }) %></div></section>
<%- include('partials/foot') %>