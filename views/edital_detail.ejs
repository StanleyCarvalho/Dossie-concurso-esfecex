<%- include('partials/head', { title: 'Matriz do edital' }) %>
<div class="page-header"><span class="eyebrow">Matriz oficial de conteúdo</span><h1>Edital <%= edital.ano %> · <%= edital.cargo %></h1><p class="muted">Conteúdos extraídos do PDF oficial e cruzados com a recorrência histórica e sua prioridade de estudo.</p></div>
<section class="card"><div class="table-wrap"><table><thead><tr><th>Disciplina</th><th>Assunto</th><th>Subassunto</th><th>Trecho do edital</th><th>Histórico / prioridade</th><th></th></tr></thead><tbody><% topics.forEach(t=>{ %><tr><td><%= t.discipline %></td><td><strong><%= t.topic %></strong></td><td><%= t.subtopic || '—' %></td><td class="muted"><%= t.reference_text || '—' %></td><td><% if(t.priority){ %><strong><%= t.priority.priority_score %>/100</strong><div class="muted"><%= t.priority.evidence %></div><% } else { %><span class="tag">Novo no edital</span><% } %></td><td><a class="btn secondary" href="/treino?discipline=<%= encodeURIComponent(t.discipline) %>&topic=<%= encodeURIComponent(t.topic) %>">Treinar</a></td></tr><% }) %></tbody></table></div></section>
<div class="actions"><a class="btn" href="/estudar-hoje">Gerar prioridade de estudo</a><a class="btn secondary" href="/recorrencias">Ver recorrências</a></div>
<%- include('partials/foot') %>