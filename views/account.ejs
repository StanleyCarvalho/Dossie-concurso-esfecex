<%- include('partials/head', { title: 'Minha conta' }) %>
<div class="page-header"><span class="eyebrow">Perfil do aluno</span><h1>Minha conta</h1><p class="muted">Mantenha seus dados atualizados. Seu e-mail é usado como identificação de acesso e não é alterado nesta tela.</p></div>
<% if(saved){ %><div class="notice success">Dados atualizados com sucesso.</div><% } %>
<div class="grid grid-2" style="align-items:start">
  <section class="card"><h2>Dados pessoais</h2><form method="POST" action="/minha-conta" class="auth-form"><label>Nome completo<input name="name" value="<%= profile.name || '' %>" required></label><label>E-mail<input value="<%= profile.email %>" disabled></label><label>Telefone<input name="phone" value="<%= profile.phone || '' %>" placeholder="(00) 00000-0000"></label><label>Cidade / UF<input name="city" value="<%= profile.city || '' %>" placeholder="Brasília/DF"></label><label>Profissão / ocupação<input name="occupation" value="<%= profile.occupation || '' %>" placeholder="Analista de Sistemas"></label><button class="btn" type="submit">Salvar meus dados</button></form></section>
  <section class="card"><h2>Acesso à plataforma</h2><div class="account-status"><span class="tag gold"><%= profile.role === 'admin' ? 'Administrador' : 'Aluno' %></span><span class="tag"><%= profile.approval_status === 'approved' ? 'Aprovado' : profile.approval_status %></span></div><p class="muted" style="margin-top:14px"><strong>Validade:</strong> <%= profile.role === 'admin' || !profile.access_until ? 'Sem expiração definida' : new Date(profile.access_until).toLocaleDateString('pt-BR') %></p><p class="muted"><strong>Cadastro criado em:</strong> <%= new Date(profile.created_at).toLocaleDateString('pt-BR') %></p><p class="muted">Seu acervo de provas, editais, questões, simulados, progresso e planejamento é isolado dos demais alunos.</p></section>
</div>
<%- include('partials/foot') %>