<%- include('partials/head', { title: 'Editais' }) %>
<div class="page-header"><span class="eyebrow">Inteligência do edital</span><h1>Editais</h1><p class="muted">Envie o edital oficial para cruzar o conteúdo programático com as provas anteriores.</p></div>
<section class="card"><h2>Importar edital</h2><form method="POST" action="/editais" enctype="multipart/form-data" class="filters"><label>Ano<input type="number" name="ano" required value="2027"></label><label>Banca<input name="banca" value="VUNESP"></label><label>Cargo<input name="cargo" value="Informática"></label><label>PDF<input type="file" name="editalPdf" accept="application/pdf" required></label><button class="btn" type="submit">Analisar edital</button></form><% if(result&&result.error){ %><p class="error"><%= result.error %></p><% } %></section>
<section class="card"><h2>Editais analisados</h2><% if(!editais.length){ %><p class="muted">Nenhum edital importado.</p><% } %><% editais.forEach(e=>{ %><div class="row"><strong><%= e.ano %> · <%= e.cargo %></strong><span class="muted"><%= e.topics_count || 0 %> tópicos extraídos · <%= e.filename || '' %></span></div><% }) %></section>
<div class="actions"><a class="btn secondary" href="/recorrencias">Ver questões recorrentes</a><a class="btn secondary" href="/estudar-hoje">O que estudar hoje</a></div>
<%- include('partials/foot') %>