<%- include('partials/head', { title: 'Editais' }) %>
<div class="page-header"><span class="eyebrow">Inteligência do edital</span><h1>Editais</h1><p class="muted">Envie o PDF oficial. A aplicação extrai a matriz de conteúdos e cruza cada item com as suas provas importadas e com seu desempenho.</p></div>
<section class="card"><h2>Importar edital</h2><form method="POST" action="/editais" enctype="multipart/form-data" class="filters"><label>Ano<input type="number" name="ano" required value="2027"></label><label>Banca<input name="banca" value="VUNESP"></label><label>Cargo<input name="cargo" value="Informática"></label><label>PDF<input type="file" name="editalPdf" accept="application/pdf" required></label><button class="btn" type="submit">Analisar edital</button></form><% if(result&&result.error){ %><p class="error"><%= result.error %></p><% } %><% if(result&&result.success){ %><div class="notice success"><%= result.message %></div><% } %></section>
<section class="card"><h2>Editais analisados</h2><% if(!editais.length){ %><p class="muted">Nenhum edital importado. Seu acervo começa vazio e será formado pelos documentos que você adicionar.</p><% } %><% editais.forEach(e=>{ %><div class="row edital-row" style="justify-content:space-between;gap:16px;"><div><strong><%= e.ano %> · <%= e.cargo %></strong><div class="muted"><%= e.topics_count || 0 %> tópicos extraídos · <%= e.filename || '' %></div></div><div class="edital-actions"><a class="btn secondary" href="/editais/<%= e.id %>">Abrir matriz</a><form method="POST" action="/editais/<%= e.id %>/delete" onsubmit="return confirm('Excluir este edital e todos os tópicos extraídos dele? Esta ação não pode ser desfeita.')"><button class="btn secondary danger-btn" type="submit">Excluir edital</button></form></div></div><% }) %></section>
<div class="actions"><a class="btn secondary" href="/recorrencias">Ver questões recorrentes</a><a class="btn secondary" href="/estudar-hoje">O que estudar hoje</a></div>
<%- include('partials/foot') %>