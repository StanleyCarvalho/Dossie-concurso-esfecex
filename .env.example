# Chave da API do Google Gemini (GRATUITA, sem cartão de crédito)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo usado para as tarefas de IA (extração de PDF, análise de padrões, plano de estudos)
# Modelo recomendado pela API do Gemini para novos usuários
GEMINI_MODEL=gemini-3.6-flash

# Modelos alternativos usados automaticamente quando o principal retorna 429/5xx
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Porta do servidor
PORT=3000
